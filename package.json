{
  "name": "easy-larky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write src tests scripts",
    "check:format": "prettier --check src tests scripts"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.103.0",
    "@douyinfe/semi-ui": "^2.103.0",
    "@larksuite/channel": "0.7.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
